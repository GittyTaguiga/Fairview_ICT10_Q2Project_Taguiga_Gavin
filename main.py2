from pyscript import document
# Elements
# Dictionary with info about Elements:
# Elements: Symbol, Name, Atomic Number, & Atomic Mass
elements = {"H": ("Hydrogen", 1, 1.008),
            "C": ("Carbon", 6, 12.011), 
            "N": ("Nitrogen", 7, 14.007), 
            "O": ("Oxygen", 8, 15.999), 
            "P": ("Phosphorus", 15, 30.974), 
            "S": ("Sulfur", 16, 32.06), 
            "Se": ("Selenium", 34, 78.971)}
#           Key:        Value:

# Create a function to search an element
def search_element (e):
    # Get the input from HTML
    Element1 = document.getElementById("element1").value
    # Retrieve information from the dictionary
    result = elements.get(Element1,("Element not found", "-", "-"))
    #Display of result
    document.getElementById("symbol").innerText = Element1
    document.getElementById("name").innerText = result[0]
    document.getElementById("atomic_number").innerText = result[1]
    document.getElementById("atomic_mass").innerText = result[2]